# Site
NEXT_PUBLIC_SITE_URL=https://minoqtopus.com

# Supabase (forms + admin)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Admin dashboard (shared password)
# Both are required in production — the app refuses to sign sessions without a secret.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=long-random-string

# Google Search Console verification for the minoqtopus.com property.
# Re-issue this from Search Console; the old token belonged to the previous domain.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
